{
  "name": "@pomaster/dsh-bundle",
  "description": "POMaster Workbench integration for DeepSeek Harness (PR-1 spike): read-only pomaster_project_overview agent tool + web panel entry. No fork, no DSH core patches — profile-layer bundle only (PRD §4/§31). Zero @deepseek-ai imports by design (compatibility layer), so the profile needs no peer resolution.",
  "version": "0.1.0-spike.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./tools": "./dist/tools.js",
    "./client": "./dist/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "locale"
  ],
  "icon": "./icon.svg",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs"
  },
  "devDependencies": {
    "@pomaster/client-contract": "workspace:*",
    "@pomaster/workbench-model": "workspace:*",
    "@types/react": "~18.3.1",
    "esbuild": "0.28.2",
    "typescript": "^5.7.3"
  }
}
